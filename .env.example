# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Azure Speech (for client-side STT fallback)
VITE_AZURE_SPEECH_KEY=your_azure_speech_key
VITE_AZURE_SPEECH_REGION=your_azure_speech_region

# Admin
VITE_ADMIN_EMAIL=your_admin_email@example.com

# Analytics
VITE_POSTHOG_KEY=your_posthog_key
VITE_POSTHOG_HOST=https://app.posthog.com

# Firebase (for push notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Stripe (client-side payment links)
VITE_STRIPE_US_PRO_MONTHLY_LINK=your_us_monthly_stripe_link
VITE_STRIPE_US_PRO_YEARLY_LINK=your_us_yearly_stripe_link

# Ads
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=your_adsense_client_id

# Voice STT Edge Function URL (optional override)
VITE_STT_API_URL=your_stt_edge_function_url
