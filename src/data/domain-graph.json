{"nodes":[{"id":"trade:plumber","label":"plumber","file_type":"domain","kind":"trade","keywords":["pipe","burst","leak","tap","faucet","toilet","water heater","stopcock","flooding","radiator"],"_origin":"domain"},{"id":"scenario:plumber:0","label":"Burst pipe causing sudden flooding","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Locate and turn off the main stopcock/shut-off valve immediately. Isolate nearby electrics if safe. DO NOT: Attempt to bind the pipe with tape while under pressure or use unapproved temporary fittings.","trade":"plumber","_origin":"domain"},{"id":"authority:water-regulations-advisory-scheme-wras-","label":"Water Regulations Advisory Scheme (WRAS)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.wrasapprovals.co.uk/","_origin":"domain"},{"id":"authority:ipc-international-code-council-","label":"IPC (International Code Council)","file_type":"domain","kind":"authority","region":"US","url":"https://www.iccsafe.org/","_origin":"domain"},{"id":"scenario:plumber:1","label":"Toilet overflowing continuously","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Turn off the toilet water supply valve located behind or near the base of the toilet. Clean contaminated areas safely. DO NOT: Keep flushing in an attempt to clear it.","trade":"plumber","_origin":"domain"},{"id":"authority:uk-building-regs-part-g","label":"UK Building Regs Part G","file_type":"domain","kind":"authority","region":"UK","url":"https://www.gov.uk/government/publications/sanitation-hot-water-safety-and-water-efficiency-approved-document-g","_origin":"domain"},{"id":"authority:upc-iapmo-","label":"UPC (IAPMO)","file_type":"domain","kind":"authority","region":"US","url":"https://www.iapmo.org/","_origin":"domain"},{"id":"scenario:plumber:2","label":"Water heater leaking heavily","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Turn off the cold water supply to the heater and shut off its power source (gas or electric). DO NOT: Touch the hot water tank or attempt to plug the pressure relief valve.","trade":"plumber","_origin":"domain"},{"id":"authority:ciphe","label":"CIPHE","file_type":"domain","kind":"authority","region":"UK","url":"https://www.ciphe.org.uk/","_origin":"domain"},{"id":"authority:asse-international","label":"ASSE International","file_type":"domain","kind":"authority","region":"US","url":"https://www.asse-plumbing.org/","_origin":"domain"},{"id":"trade:electrician","label":"electrician","file_type":"domain","kind":"trade","keywords":["electric","power","breaker","consumer unit","socket","outlet","spark","burning smell","fuse"],"_origin":"domain"},{"id":"scenario:electrician:3","label":"Burning smell coming from a plug socket","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Turn off the circuit breaker immediately at the main panel. Unplug devices only if safe to do so without touching the socket face. DO NOT: Ignore the smell or use the socket.","trade":"electrician","_origin":"domain"},{"id":"authority:electrical-safety-first","label":"Electrical Safety First","file_type":"domain","kind":"authority","region":"UK","url":"https://www.electricalsafetyfirst.org.uk/","_origin":"domain"},{"id":"authority:national-electrical-code-nfpa-70-","label":"National Electrical Code (NFPA 70)","file_type":"domain","kind":"authority","region":"US","url":"https://www.nfpa.org/","_origin":"domain"},{"id":"scenario:electrician:4","label":"Live wires exposed or burning smell from sockets","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Isolate power at the main consumer unit/breaker panel immediately using safe isolation procedures. DO NOT: Touch the wires even if power appears off; do not attempt DIY repairs on live circuits.","trade":"electrician","_origin":"domain"},{"id":"authority:hse-electricity-at-work-regulations-1989","label":"HSE / Electricity at Work Regulations 1989","file_type":"domain","kind":"authority","region":"UK","url":"https://www.hse.gov.uk/pubns/priced/hsr25.pdf","_origin":"domain"},{"id":"authority:osha-electrical-standards","label":"OSHA Electrical Standards","file_type":"domain","kind":"authority","region":"US","url":"https://www.osha.gov/","_origin":"domain"},{"id":"scenario:electrician:5","label":"RCD or GFCI continuously tripping","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Unplug all appliances on the affected circuit and attempt to reset. If it trips again, leave it off and call a professional. DO NOT: Tape the breaker switch up or bypass the safety switch.","trade":"electrician","_origin":"domain"},{"id":"authority:bs-7671-iet-","label":"BS 7671 (IET)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.theiet.org/","_origin":"domain"},{"id":"authority:underwriters-laboratories-ul-","label":"Underwriters Laboratories (UL)","file_type":"domain","kind":"authority","region":"US","url":"https://www.ul.com/","_origin":"domain"},{"id":"trade:gas-engineer","label":"gas engineer","file_type":"domain","kind":"trade","keywords":["gas","gas leak","boiler","pilot light","carbon monoxide","smell gas"],"_origin":"domain"},{"id":"scenario:gas-engineer:6","label":"Gas leak or strong smell of gas","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Open all windows/doors immediately; turn off the emergency control valve at the meter; vacate the premises. DO NOT: Use electrical switches, smoke, or use mobile phones inside. Safety note: Incomplete combustion (yellow flame) indicates deadly Carbon Monoxide.","trade":"gas-engineer","_origin":"domain"},{"id":"authority:gas-safe-register-uk-gas-safety-regs","label":"Gas Safe Register / UK Gas Safety Regs","file_type":"domain","kind":"authority","region":"UK","url":"https://www.gassaferegister.co.uk/","_origin":"domain"},{"id":"authority:nfpa-54-national-fuel-gas-code-","label":"NFPA 54 (National Fuel Gas Code)","file_type":"domain","kind":"authority","region":"US","url":"https://www.nfpa.org/","_origin":"domain"},{"id":"scenario:gas-engineer:7","label":"Carbon monoxide alarm sounding","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Evacuate the property immediately, leave doors open to ventilate, and call emergency services or the gas emergency number. DO NOT: Stay inside to try and find the source.","trade":"gas-engineer","_origin":"domain"},{"id":"authority:hse-gas-safety","label":"HSE Gas Safety","file_type":"domain","kind":"authority","region":"UK","url":"https://www.hse.gov.uk/gas/","_origin":"domain"},{"id":"authority:american-public-gas-association-apga-","label":"American Public Gas Association (APGA)","file_type":"domain","kind":"authority","region":"US","url":"https://www.apga.org/","_origin":"domain"},{"id":"scenario:gas-engineer:8","label":"Yellow or orange flame on gas boiler or hob","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Stop using the appliance immediately, turn off the gas supply, and ventilate the room. DO NOT: Ignore it; a yellow flame indicates incomplete combustion and deadly carbon monoxide.","trade":"gas-engineer","_origin":"domain"},{"id":"authority:institution-of-gas-engineers-and-managers-igem-","label":"Institution of Gas Engineers and Managers (IGEM)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.igem.org.uk/","_origin":"domain"},{"id":"authority:american-gas-association-aga-","label":"American Gas Association (AGA)","file_type":"domain","kind":"authority","region":"US","url":"https://www.aga.org/","_origin":"domain"},{"id":"trade:locksmith","label":"locksmith","file_type":"domain","kind":"trade","keywords":["locked out","lock","key","broken key","door wont open","snapped key"],"_origin":"domain"},{"id":"scenario:locksmith:9","label":"Key snapped off inside the lock cylinder","file_type":"domain","kind":"scenario","risk_level":"Urgent repair","action_plan":"DO: Leave the broken piece inside and call a professional for extraction. DO NOT: Try to dig it out with pins or screwdrivers as this pushes it further in and destroys the pins.","trade":"locksmith","_origin":"domain"},{"id":"authority:master-locksmiths-association-mla-","label":"Master Locksmiths Association (MLA)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.locksmiths.co.uk/","_origin":"domain"},{"id":"authority:aloa-security-professionals","label":"ALOA Security Professionals","file_type":"domain","kind":"authority","region":"US","url":"https://www.aloa.org/","_origin":"domain"},{"id":"scenario:locksmith:10","label":"Broken lock or burglary repair (uPVC/Timber doors)","file_type":"domain","kind":"scenario","risk_level":"Urgent Security Repair","action_plan":"DO: Secure the property immediately. For timber doors, ensure BS 3621 certified locks are used. For uPVC doors, upgrade to SS 312 Diamond cylinders to prevent lock snapping. DO NOT: Compromise fire escape routes by adding non-compliant locks.","trade":"locksmith","_origin":"domain"},{"id":"trade:drain-specialist","label":"drain specialist","file_type":"domain","kind":"trade","keywords":["drain","blocked","sewage","backed up","manhole"],"_origin":"domain"},{"id":"scenario:drain-specialist:11","label":"Sewage backing up into shower or ground floor fixtures","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Stop using all water in the house immediately to prevent further flooding. DO NOT: Pour harsh chemical unblockers down the drain as they will sit in the pipe and endanger the engineer.","trade":"drain-specialist","_origin":"domain"},{"id":"authority:uk-building-regs-part-h","label":"UK Building Regs Part H","file_type":"domain","kind":"authority","region":"UK","url":"https://www.gov.uk/government/publications/drainage-and-waste-disposal-approved-document-h","_origin":"domain"},{"id":"authority:epa-wastewater-programs","label":"EPA Wastewater Programs","file_type":"domain","kind":"authority","region":"US","url":"https://www.epa.gov/npdes","_origin":"domain"},{"id":"scenario:drain-specialist:12","label":"Sinkhole appearing near exterior drain pipe","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Keep people and vehicles completely away from the area; call a drainage specialist for a CCTV survey. DO NOT: Walk near the edge or attempt to fill it with dirt without fixing the collapsed pipe.","trade":"drain-specialist","_origin":"domain"},{"id":"authority:water-uk","label":"Water UK","file_type":"domain","kind":"authority","region":"UK","url":"https://www.water.org.uk/","_origin":"domain"},{"id":"authority:nassco","label":"NASSCO","file_type":"domain","kind":"authority","region":"US","url":"https://www.nassco.org/","_origin":"domain"},{"id":"trade:glazier","label":"glazier","file_type":"domain","kind":"trade","keywords":["window","glass","broken window","shopfront","smashed"],"_origin":"domain"},{"id":"scenario:glazier:13","label":"Shattered sliding glass door or low-level window","file_type":"domain","kind":"scenario","risk_level":"Urgent repair","action_plan":"DO: Keep pets and children out of the room; apply heavy-duty tape over cracks if the pane is still intact. DO NOT: Try to remove large, jagged shards without heavy protective gloves and eyewear.","trade":"glazier","_origin":"domain"},{"id":"authority:bs-6262-glazing-safety","label":"BS 6262 Glazing Safety","file_type":"domain","kind":"authority","region":"UK","url":"https://www.bsigroup.com/","_origin":"domain"},{"id":"authority:national-glass-association-nga-","label":"National Glass Association (NGA)","file_type":"domain","kind":"authority","region":"US","url":"https://www.glass.org/","_origin":"domain"},{"id":"scenario:glazier:14","label":"Condensation permanently trapped between double glazed panes","file_type":"domain","kind":"scenario","risk_level":"Standard repair","action_plan":"DO: Arrange for the sealed glass unit to be measured and replaced by a professional. DO NOT: Attempt to drill holes in the glass to let the moisture out; this destroys the thermal efficiency completely.","trade":"glazier","_origin":"domain"},{"id":"authority:fensa","label":"FENSA","file_type":"domain","kind":"authority","region":"UK","url":"https://www.fensa.org.uk/","_origin":"domain"},{"id":"authority:fgia-formerly-igma-","label":"FGIA (Formerly IGMA)","file_type":"domain","kind":"authority","region":"US","url":"https://fgiaonline.org/","_origin":"domain"},{"id":"trade:roofer","label":"roofer","file_type":"domain","kind":"trade","keywords":["roof","tile","leak from ceiling","storm damage","gutter"],"_origin":"domain"},{"id":"scenario:roofer:15","label":"Water pouring through ceiling during heavy storm","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Place buckets to catch water; safely pierce a small hole in a bulging plaster ceiling to release trapped water. DO NOT: Climb onto a wet, slippery roof during a storm to attempt temporary repairs.","trade":"roofer","_origin":"domain"},{"id":"authority:national-federation-of-roofing-contractors-nfrc-","label":"National Federation of Roofing Contractors (NFRC)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.nfrc.co.uk/","_origin":"domain"},{"id":"authority:nrca","label":"NRCA","file_type":"domain","kind":"authority","region":"US","url":"https://www.nrca.net/","_origin":"domain"},{"id":"scenario:roofer:16","label":"Roofline visibly sagging from the outside","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Evacuate the area directly below the sag and request a structural roofing inspection immediately. DO NOT: Attempt to prop it up from the inside without structural calculations.","trade":"roofer","_origin":"domain"},{"id":"authority:british-board-of-agr-ment-bba-","label":"British Board of Agrément (BBA)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.bbacerts.co.uk/","_origin":"domain"},{"id":"authority:international-building-code-ibc-","label":"International Building Code (IBC)","file_type":"domain","kind":"authority","region":"US","url":"https://www.iccsafe.org/","_origin":"domain"},{"id":"trade:builder","label":"builder","file_type":"domain","kind":"trade","keywords":["wall","structural","collapse","subsidence","crack"],"_origin":"domain"},{"id":"scenario:builder:17","label":"Large, stepped cracks appearing in exterior brickwork","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Monitor the crack with a gauge; check for internal symptoms like sticking doors or sloping floors. DO NOT: Simply fill the crack with mortar without having a structural engineer identify the root cause.","trade":"builder","_origin":"domain"},{"id":"authority:uk-building-regulations-part-a","label":"UK Building Regulations Part A","file_type":"domain","kind":"authority","region":"UK","url":"https://www.gov.uk/government/publications/structure-approved-document-a","_origin":"domain"},{"id":"authority:associated-general-contractors-agc-","label":"Associated General Contractors (AGC)","file_type":"domain","kind":"authority","region":"US","url":"https://www.agc.org/","_origin":"domain"},{"id":"scenario:builder:18","label":"Removing an internal timber stud wall or plasterboard partition","file_type":"domain","kind":"scenario","risk_level":"Standard repair","action_plan":"DO: Hire a structural engineer to survey the wall before any demolition. Timber stud walls often support upper floor joists or roof loads. DO NOT: Assume a timber wall is non-load-bearing just because it is not brick; removing a structural timber wall can cause ceiling collapse or structural sagging.","trade":"builder","_origin":"domain"},{"id":"authority:citb-construction-industry-training-board-","label":"CITB (Construction Industry Training Board)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.citb.co.uk/","_origin":"domain"},{"id":"authority:nahb-national-association-of-home-builders-","label":"NAHB (National Association of Home Builders)","file_type":"domain","kind":"authority","region":"US","url":"https://www.nahb.org/","_origin":"domain"},{"id":"trade:water-restoration","label":"water restoration","file_type":"domain","kind":"trade","keywords":["flood","water damage","water everywhere","soaked","cleanup"],"_origin":"domain"},{"id":"scenario:water-restoration:19","label":"Flooded basement with standing water","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Turn off the electricity to the basement from the main breaker panel located upstairs or outside. DO NOT: Wade into floodwater if the power is still on or if it smells of raw sewage.","trade":"water-restoration","_origin":"domain"},{"id":"authority:british-damage-management-association-bdma-","label":"British Damage Management Association (BDMA)","file_type":"domain","kind":"authority","region":"UK","url":"https://www.bdma.org.uk/","_origin":"domain"},{"id":"authority:iicrc","label":"IICRC","file_type":"domain","kind":"authority","region":"US","url":"https://iicrc.org/","_origin":"domain"},{"id":"scenario:water-restoration:20","label":"Extensive black mould covering walls or ceiling","file_type":"domain","kind":"scenario","risk_level":"Urgent repair","action_plan":"DO: Wear an N95 mask if in the room; improve ventilation; identify and fix the underlying moisture leak. DO NOT: Dry-brush the mould or scrape it, as this releases millions of toxic spores into the air.","trade":"water-restoration","_origin":"domain"},{"id":"authority:rics","label":"RICS","file_type":"domain","kind":"authority","region":"UK","url":"https://www.rics.org/","_origin":"domain"},{"id":"authority:restoration-industry-association-ria-","label":"Restoration Industry Association (RIA)","file_type":"domain","kind":"authority","region":"US","url":"https://www.restorationindustry.org/","_origin":"domain"},{"id":"trade:breakdown","label":"breakdown","file_type":"domain","kind":"trade","keywords":["car","broke down","tow","flat tyre","wont start","stranded"],"_origin":"domain"},{"id":"scenario:breakdown:21","label":"Vehicle loses power entirely on a busy highway","file_type":"domain","kind":"scenario","risk_level":"Critical emergency","action_plan":"DO: Indicate and pull over to the hard shoulder; turn on hazard lights immediately; exit from the non-traffic side. DO NOT: Stay inside the vehicle if parked in a live lane, and do not stand directly behind the vehicle.","trade":"breakdown","_origin":"domain"},{"id":"authority:national-highways","label":"National Highways","file_type":"domain","kind":"authority","region":"UK","url":"https://nationalhighways.co.uk/","_origin":"domain"},{"id":"authority:nhtsa","label":"NHTSA","file_type":"domain","kind":"authority","region":"US","url":"https://www.nhtsa.gov/","_origin":"domain"},{"id":"scenario:breakdown:22","label":"Engine temperature gauge hits the red zone/smoking","file_type":"domain","kind":"scenario","risk_level":"Major emergency","action_plan":"DO: Pull over safely and turn the engine off immediately to prevent catastrophic block warping. DO NOT: Open the radiator cap while the engine is hot, as boiling coolant will spray out under high pressure.","trade":"breakdown","_origin":"domain"},{"id":"authority:dvsa","label":"DVSA","file_type":"domain","kind":"authority","region":"UK","url":"https://www.gov.uk/government/organisations/driver-and-vehicle-standards-agency","_origin":"domain"},{"id":"authority:fmcsa","label":"FMCSA","file_type":"domain","kind":"authority","region":"US","url":"https://www.fmcsa.dot.gov/","_origin":"domain"},{"id":"trade:hvac","label":"hvac","file_type":"domain","kind":"trade","keywords":["air con","aircon","ac","cooling","heating","no heat","air conditioning"],"_origin":"domain"},{"id":"scenario:hvac:23","label":"AC unit blowing warm air and making a hissing sound","file_type":"domain","kind":"scenario","risk_level":"Urgent repair","action_plan":"DO: Turn the system off at the thermostat to prevent burning out the compressor motor. DO NOT: Attempt to top up the refrigerant yourself; venting fluorinated gases into the atmosphere is illegal.","trade":"hvac","_origin":"domain"},{"id":"authority:refcom","label":"REFCOM","file_type":"domain","kind":"authority","region":"UK","url":"https://www.refcom.org.uk/","_origin":"domain"},{"id":"authority:epa-section-608","label":"EPA Section 608","file_type":"domain","kind":"authority","region":"US","url":"https://www.epa.gov/section608","_origin":"domain"},{"id":"scenario:hvac:24","label":"Furnace smells strongly like burning dust or electrical burning","file_type":"domain","kind":"scenario","risk_level":"Urgent repair","action_plan":"DO: If it's the first time turning it on for winter, let it run for 10 minutes to burn off dust. If the smell persists or smells like melting plastic, turn it off immediately. DO NOT: Store flammable materials near the unit.","trade":"hvac","_origin":"domain"},{"id":"authority:besa","label":"BESA","file_type":"domain","kind":"authority","region":"UK","url":"https://www.thebesa.com/","_origin":"domain"},{"id":"authority:ashrae","label":"ASHRAE","file_type":"domain","kind":"authority","region":"US","url":"https://www.ashrae.org/","_origin":"domain"}],"edges":[{"source":"trade:plumber","target":"scenario:plumber:0","relation":"handles","confidence":"DOMAIN","weight":1},{"source":"scenario:plumber:0","target":"authority:water-regulations-advisory-scheme-wras-","relation":"governed_by_uk","confidence":"DOMAIN","weight":1},{"source":"scenario:plumber:0","target":"authority:ipc-international-code-council-","relation":"governed_by_us","confidence":"DOMAIN","weight":1},{"source":"trade:plumber","target":"scenario:plumber:1","relatio